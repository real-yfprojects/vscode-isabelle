{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": { "reveal": "never" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "seed dev profile",
      "type": "process",
      "command": "node",
      "args": ["test/dev-profile.js"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "dev: compile + seed profile",
      "dependsOn": ["npm: compile", "seed dev profile"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
