{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (patched Isabelle)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/test/workspace",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.dev-profile",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "dev: compile + seed profile"
    }
  ]
}
