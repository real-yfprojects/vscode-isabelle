node_modules/
out/
.vscode-test/
.dev-profile/
test/READY
# scratch theories generated by the test suites
test/workspace/*.thy
# ...except the hand-test fixture: the dev harness opens this folder, so it wants to
# live here rather than beside the generated scratch theories.
!test/workspace/Hover.thy
!test/workspace/Probe.thy
# suite30 drives both new panels against a real prover; without this fixture it has
# nothing to trace and no thy_deps to draw.
!test/workspace/Trace.thy
!test/workspace/Deps.thy
test/perf.json
test/results.json

# Build artifact from "npm run package".
*.vsix

# suite30 writes isabelle.home and the panel flags here via ConfigurationTarget.Workspace.
# Run through runAll they land in a per-suite copy, but run directly they land here -- and
# a committed one pins every machine to the author's absolute path. CI read
# "C:/Users/.../Isabelle2025-2-query" on a Linux runner and failed every prover suite.
test/workspace/.vscode/
