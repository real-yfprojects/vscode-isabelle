# What must NOT go into the .vsix. Everything else in the tree is packaged, so this is
# the list that keeps a 100 MB node_modules and the whole test harness out of it.
#
# Kept deliberately: out/, package.json, language-configuration.json, syntaxes/, media/,
# README.md and LICENSE. The grammar and the language configuration are contribution
# paths -- dropping either leaves the extension installable and silently unable to
# highlight or to place a cursor correctly.

.vscode/**
.vscode-test/**
.dev-profile/**
.github/**
.gitignore

# TypeScript sources and build inputs: out/ is what runs.
src/**
tsconfig.json
**/*.ts
**/*.map

# The harness. suite*.js drive a spawned editor and have no business in a package.
test/**
scripts/**

# Working notes and design docs, not user documentation. The README links to docs/ on
# GitHub, which is where the Marketplace sends those links anyway.
TODO.md
docs/**

# The extended server: ship the jar and Isabelle's copyright notice that must travel
# with it, not the pointer to the commit it is built from.
server/*.ref
.server-build/**

node_modules/**
package-lock.json
